# Copy to a local .env (do not commit). Inter-container values use Compose service names.

# Web (Nuxt)
NUXT_SERVER_NAME=WEB-LOCAL
NUXT_NODE_COORDINATOR_URL=http://node-coordinator:3000

# NestJS nodes (replicas point to the coordinator)
NODE_COORDINATOR_URL=http://node-coordinator:3000
ROLE=coordinator
NODE_ID=coordinator
PORT=3000

# User HTTP entry point on the host (HAProxy published by Compose)
# http://localhost:8080