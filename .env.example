# Copie para .env local (não commitar). Valores entre contêineres usam nomes de serviço Compose.

# Web (Nuxt)
NUXT_SERVER_NAME=WEB-LOCAL
NUXT_NODE_COORDINATOR_URL=http://node-coordinator:3000

# Nós NestJS (réplicas apontam para o coordenador)
NODE_COORDINATOR_URL=http://node-coordinator:3000
ROLE=coordinator
NODE_ID=coordinator
PORT=3000

# Entrada HTTP do usuário no host (HAProxy publicado no Compose)
# http://localhost:8080